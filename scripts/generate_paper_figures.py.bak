#!/usr/bin/env python3
"""Generate Nature Communications-style figures for CAILP-Social (reproducible)."""
from __future__ import annotations

import json
import sys
from collections import defaultdict
from pathlib import Path

import matplotlib.pyplot as plt
import numpy as np

ROOT = Path(__file__).resolve().parents[1]
GRID = ROOT / "results" / "raw" / "grid"
OUT = ROOT / "paper" / "figures"
OUT.mkdir(parents=True, exist_ok=True)

CORE = [
    "cailp_multi",
    "cailp_a31",
    "original_ilp",
    "ptdnet",
    "neuralsparse",
    "random",
    "dspar",
]
LABELS = {
    "cailp_multi": "CAILP multi",
    "cailp_a31": "A31 fidelity-only",
    "original_ilp": "Original ILP-GCN",
    "ptdnet": "PTDNet",
    "neuralsparse": "NeuralSparse",
    "random": "Random",
    "dspar": "DSpar/ER proxy",
    "effective_resistance": "DSpar/ER proxy",
}
COLORS = {
    "cailp_multi": "#0072B2",
    "cailp_a31": "#56B4E9",
    "original_ilp": "#009E73",
    "ptdnet": "#D55E00",
    "neuralsparse": "#CC79A7",
    "random": "#999999",
    "dspar": "#E69F00",
}


def load_rows():
    rows = []
    for p in sorted(GRID.glob("*.json")):
        if p.name.startswith("ablation_") or p.name.endswith(".error.json"):
            continue
        data = json.loads(p.read_text())
        if isinstance(data, list):
            rows.extend(data)
        elif isinstance(data, dict) and "test_macro_f1" in data:
            rows.append(data)
    # collapse ER into dspar label for plotting
    for r in rows:
        if r.get("method") == "effective_resistance":
            r["method"] = "dspar"
        if r.get("method", "").startswith("cailp_multi_teacher"):
            continue
    return [r for r in rows if not str(r.get("method", "")).startswith("cailp_multi_teacher")]


def mean_ci(vals):
    a = np.asarray(vals, float)
    if len(a) == 0:
        return np.nan, np.nan, np.nan, 0
    m = float(np.mean(a))
    s = float(np.std(a, ddof=1)) if len(a) > 1 else 0.0
    # 95% CI approx
    half = 1.96 * s / np.sqrt(len(a)) if len(a) > 1 else 0.0
    return m, m - half, m + half, len(a)


def sparsity_auc(budgets, f1s):
    pairs = sorted(zip(budgets, f1s))
    if len(pairs) < 2:
        return np.nan
    xs = np.array([p[0] for p in pairs], float)
    ys = np.array([p[1] for p in pairs], float)
    return float(np.trapz(ys, xs))


def style():
    plt.rcParams.update(
        {
            "font.family": "sans-serif",
            "font.sans-serif": ["Arial", "Helvetica", "DejaVu Sans"],
            "font.size": 8,
            "axes.labelsize": 9,
            "axes.titlesize": 9,
            "legend.fontsize": 7,
            "xtick.labelsize": 8,
            "ytick.labelsize": 8,
            "axes.linewidth": 0.8,
            "pdf.fonttype": 42,
            "ps.fonttype": 42,
        }
    )


def fig2_curves(rows):
    style()
    datasets = [d for d in ["lastfm", "facebook"] if any(r.get("dataset") == d for r in rows)]
    fig, axes = plt.subplots(1, len(datasets), figsize=(7.2, 3.0), sharey=False)
    if len(datasets) == 1:
        axes = [axes]
    budgets = [0.1 * i for i in range(1, 10)]
    for ax, ds in zip(axes, datasets):
        for method in CORE:
            xs, ys, lo, hi = [], [], [], []
            for b in budgets:
                vals = [
                    r["test_macro_f1"]
                    for r in rows
                    if r.get("dataset") == ds
                    and r.get("method") == method
                    and abs(float(r.get("removal_rate", -1)) - b) < 1e-9
                ]
                m, l, h, n = mean_ci(vals)
                if n == 0:
                    continue
                xs.append(b)
                ys.append(m)
                lo.append(l)
                hi.append(h)
            if not xs:
                continue
            c = COLORS[method]
            ax.plot(xs, ys, color=c, lw=1.5, label=LABELS[method])
            ax.fill_between(xs, lo, hi, color=c, alpha=0.18, linewidth=0)
        ax.set_xlabel("Edge removal rate")
        ax.set_ylabel("Test Macro-F1")
        title = "LastFM Asia" if ds == "lastfm" else "Facebook Page-Page"
        nseeds = len({r["seed"] for r in rows if r.get("dataset") == ds and r.get("method") == "cailp_multi"})
        ax.set_title(f"{title} (CAILP seeds n={nseeds})")
        ax.set_xlim(0.05, 0.95)
        ax.spines["top"].set_visible(False)
        ax.spines["right"].set_visible(False)
    axes[0].legend(frameon=False, loc="lower left", ncol=1)
    fig.tight_layout()
    fig.savefig(OUT / "fig2_sparsity_curves.pdf", bbox_inches="tight")
    fig.savefig(OUT / "fig2_sparsity_curves.png", dpi=300, bbox_inches="tight")
    plt.close(fig)


def fig3_comparison(rows):
    style()
    fig, axes = plt.subplots(1, 2, figsize=(7.2, 3.2))
    for ax, ds, title in zip(axes, ["lastfm", "facebook"], ["LastFM Asia", "Facebook Page-Page"]):
        means, errs, labs, cols = [], [], [], []
        for method in CORE:
            aucs = []
            by_seed = defaultdict(list)
            for r in rows:
                if r.get("dataset") != ds or r.get("method") != method:
                    continue
                by_seed[r["seed"]].append((float(r["removal_rate"]), float(r["test_macro_f1"])))
            for pts in by_seed.values():
                aucs.append(sparsity_auc([p[0] for p in pts], [p[1] for p in pts]))
            m, l, h, n = mean_ci(aucs)
            if n == 0:
                continue
            means.append(m)
            errs.append(h - m)
            labs.append(LABELS[method])
            cols.append(COLORS[method])
        y = np.arange(len(means))
        ax.barh(y, means, xerr=errs, color=cols, height=0.7, error_kw={"lw": 0.8, "capsize": 2})
        ax.set_yticks(y)
        ax.set_yticklabels(labs)
        ax.set_xlabel("Sparsity–Macro-F1 AUC")
        ax.set_title(title)
        ax.spines["top"].set_visible(False)
        ax.spines["right"].set_visible(False)
        ax.invert_yaxis()
    fig.tight_layout()
    fig.savefig(OUT / "fig3_method_comparison.pdf", bbox_inches="tight")
    fig.savefig(OUT / "fig3_method_comparison.png", dpi=300, bbox_inches="tight")
    plt.close(fig)


def fig4_rq11(rows):
    style()
    fig, axes = plt.subplots(1, 2, figsize=(7.2, 3.0))
    for ax, ds, title in zip(axes, ["lastfm", "facebook"], ["LastFM Asia", "Facebook Page-Page"]):
        for method, ls in [("cailp_multi", "-"), ("cailp_a31", "--")]:
            xs, ys, lo, hi = [], [], [], []
            for b in [0.1 * i for i in range(1, 10)]:
                vals = [
                    r["test_macro_f1"]
                    for r in rows
                    if r.get("dataset") == ds
                    and r.get("method") == method
                    and abs(float(r.get("removal_rate", -1)) - b) < 1e-9
                ]
                m, l, h, n = mean_ci(vals)
                if n == 0:
                    continue
                xs.append(b)
                ys.append(m)
                lo.append(l)
                hi.append(h)
            ax.plot(xs, ys, ls=ls, color=COLORS[method], lw=1.6, label=LABELS[method])
            ax.fill_between(xs, lo, hi, color=COLORS[method], alpha=0.15)
        ax.set_title(title + " (fusion fixed: concat)")
        ax.set_xlabel("Edge removal rate")
        ax.set_ylabel("Test Macro-F1")
        ax.spines["top"].set_visible(False)
        ax.spines["right"].set_visible(False)
        ax.legend(frameon=False)
    fig.tight_layout()
    fig.savefig(OUT / "fig4_rq11.pdf", bbox_inches="tight")
    fig.savefig(OUT / "fig4_rq11.png", dpi=300, bbox_inches="tight")
    plt.close(fig)


def fig5_structure(rows):
    style()
    metrics = [
        ("giant_component_ratio", "Giant component"),
        ("bridge_preservation", "Bridge preservation"),
        ("minority_degree_retention", "Minority deg. retention"),
    ]
    methods = ["cailp_multi", "cailp_a31", "original_ilp", "ptdnet", "random"]
    fig, axes = plt.subplots(1, 2, figsize=(7.2, 3.2))
    for ax, ds, title in zip(axes, ["lastfm", "facebook"], ["LastFM @50%", "Facebook @50%"]):
        data = np.full((len(methods), len(metrics)), np.nan)
        for i, m in enumerate(methods):
            for j, (key, _) in enumerate(metrics):
                vals = [
                    r[key]
                    for r in rows
                    if r.get("dataset") == ds
                    and r.get("method") == m
                    and abs(float(r.get("removal_rate", -1)) - 0.5) < 1e-9
                    and r.get(key) is not None
                ]
                if vals:
                    data[i, j] = np.mean(vals)
        im = ax.imshow(data, cmap="viridis", aspect="auto", vmin=0.3, vmax=1.0)
        ax.set_xticks(range(len(metrics)))
        ax.set_xticklabels([t for _, t in metrics], rotation=25, ha="right")
        ax.set_yticks(range(len(methods)))
        ax.set_yticklabels([LABELS[m] for m in methods])
        ax.set_title(title)
        for i in range(data.shape[0]):
            for j in range(data.shape[1]):
                if np.isfinite(data[i, j]):
                    ax.text(j, i, f"{data[i, j]:.2f}", ha="center", va="center", color="w", fontsize=7)
    fig.colorbar(im, ax=axes.ravel().tolist(), fraction=0.025, pad=0.02, label="Metric value")
    fig.tight_layout()
    fig.savefig(OUT / "fig5_structure.pdf", bbox_inches="tight")
    fig.savefig(OUT / "fig5_structure.png", dpi=300, bbox_inches="tight")
    plt.close(fig)


def fig6_ablations():
    style()
    rows = []
    for p in GRID.glob("ablation_lastfm_*.json"):
        d = json.loads(p.read_text())
        rows.extend(d if isinstance(d, list) else [d])
    keep = [
        "A1_full_core",
        "A8_concat",
        "A9_gated",
        "A10_cross_attn",
        "A19_no_mass",
        "A24_pagerank_prior",
        "A31_single_obj_concat",
        "A32_black_hole_mass",
        "A2_original_ilp",
    ]
    labels = {
        "A1_full_core": "A1 full core",
        "A8_concat": "A8 concat",
        "A9_gated": "A9 gated",
        "A10_cross_attn": "A10 cross-attn",
        "A19_no_mass": "A19 no mass",
        "A24_pagerank_prior": "A24 PageRank",
        "A31_single_obj_concat": "A31 concat",
        "A32_black_hole_mass": "A32 Black Hole",
        "A2_original_ilp": "A2 orig. ILP",
    }
    fig, ax = plt.subplots(figsize=(7.2, 3.2))
    x = np.arange(len(keep))
    width = 0.25
    for k, rem, color in [(0, 0.3, "#0072B2"), (1, 0.5, "#D55E00"), (2, 0.7, "#009E73")]:
        means, errs = [], []
        for name in keep:
            vals = [
                r["test_macro_f1"]
                for r in rows
                if r.get("ablation") == name and abs(float(r.get("removal_rate", -1)) - rem) < 1e-9
            ]
            m, l, h, n = mean_ci(vals)
            means.append(m if n else np.nan)
            errs.append((h - m) if n else 0)
        ax.bar(x + k * width, means, width, yerr=errs, label=f"{int(rem*100)}% removal", color=color, error_kw={"lw": 0.7})
    ax.set_xticks(x + width)
    ax.set_xticklabels([labels[k] for k in keep], rotation=30, ha="right")
    ax.set_ylabel("Test Macro-F1")
    ax.set_title("LastFM ablations (seeds 0–4)")
    ax.legend(frameon=False, ncol=3)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    fig.tight_layout()
    fig.savefig(OUT / "fig6_ablations.pdf", bbox_inches="tight")
    fig.savefig(OUT / "fig6_ablations.png", dpi=300, bbox_inches="tight")
    plt.close(fig)


def fig7_runtime(rows):
    style()
    methods = ["random", "original_ilp", "ptdnet", "neuralsparse", "cailp_a31", "cailp_multi"]
    fig, axes = plt.subplots(1, 2, figsize=(7.2, 3.0))
    for ax, ds, title in zip(axes, ["lastfm", "facebook"], ["LastFM", "Facebook"]):
        means, errs, labs, cols = [], [], [], []
        for m in methods:
            # one train_seconds per seed (take from rem=0.1 rows)
            by_seed = {}
            for r in rows:
                if r.get("dataset") == ds and r.get("method") == m and r.get("train_seconds") is not None:
                    by_seed[r["seed"]] = float(r["train_seconds"])
            vals = list(by_seed.values())
            mu, l, h, n = mean_ci(vals)
            if n == 0:
                continue
            means.append(mu)
            errs.append(h - mu)
            labs.append(LABELS[m])
            cols.append(COLORS.get(m, "#444444"))
        y = np.arange(len(means))
        ax.barh(y, means, xerr=errs, color=cols, height=0.7, error_kw={"lw": 0.8, "capsize": 2})
        ax.set_yticks(y)
        ax.set_yticklabels(labs)
        ax.set_xlabel("Training time (s)")
        ax.set_title(title)
        ax.set_xscale("log")
        ax.spines["top"].set_visible(False)
        ax.spines["right"].set_visible(False)
        ax.invert_yaxis()
    fig.tight_layout()
    fig.savefig(OUT / "fig7_runtime.pdf", bbox_inches="tight")
    fig.savefig(OUT / "fig7_runtime.png", dpi=300, bbox_inches="tight")
    plt.close(fig)


def main():
    rows = load_rows()
    print(f"Loaded {len(rows)} rows")
    fig2_curves(rows)
    fig3_comparison(rows)
    fig4_rq11(rows)
    fig5_structure(rows)
    fig6_ablations()
    fig7_runtime(rows)
    print(f"Wrote figures to {OUT}")


if __name__ == "__main__":
    main()
